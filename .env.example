# Copy to /opt/ww_shop/.env on the server and fill in. Never commit the real file.
# Use a RESTRICTED key (rk_live_...) created in the Stripe Dashboard: Developers > API keys > Create restricted key.
# Permissions needed: Checkout Sessions = Write, Customers = Write, Invoices = Write, PaymentIntents = Write, Tax calculations = Write (if Stripe Tax is on).
STRIPE_SECRET_KEY=rk_test_replace_me
# Developers > Webhooks > your endpoint https://whitewaterband.com/api/webhook > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# 1 = let Stripe Tax add VAT (needs Stripe Tax set up in the Dashboard); 0 = prices stay as they are
STRIPE_TAX=0
# 1 = also show Stripe's own "accept terms" checkbox (needs the terms URL in Dashboard > Settings > Public details)
STRIPE_REQUIRE_TOS=0
SITE_URL=https://whitewaterband.com
