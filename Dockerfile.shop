# WHITEWATER shop API: Node only, no npm packages. Built by deploy/shop-api.sh on the server.
FROM node:22-alpine
WORKDIR /app
RUN echo '{"type":"module"}' > package.json
COPY server ./server
COPY src/data/products.js ./src/data/products.js
COPY src/links.js ./src/links.js
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8787 DATA_DIR=/data
VOLUME /data
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8787/api/health || exit 1
CMD ["node", "server/index.mjs"]
