# Settings read by site.sh (the script itself is the same in every landing-page repo).
NAME=ww-landing                  # Whitewater is served by the edge container itself
KIND=edge                        # edge = files go straight into ww-landing's web root
EDGE_DIR=/opt/ww_landing/dist
DOMAIN=whitewaterband.com
BUILD='[ -d node_modules ] || npm ci; npm run build'   # Vite + pre-render -> dist/

PREVIEW_NAME=ww-preview          # ./site.sh preview -> http://2.28.230.117:8081/
PREVIEW_PORT=8081
LEGACY_PREVIEW_SEED=/opt/ww_preview/dist
